APP_NAME="P3H Kemenkum Kalsel"
APP_ENV=local
APP_KEY=base64:fQg/ClcqyTuF7IFyRoJBXzd0NI/Eldmam9rnD17I4aU=
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=id

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database MySQL (sama dengan aplikasi Node.js sebelumnya)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=p3h_kemenkum_kalsel
DB_USERNAME=root
DB_PASSWORD=

# Session disimpan di cookie terenkripsi tanpa timeout idle (keluar hanya via tombol Keluar)
SESSION_DRIVER=cookie
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
